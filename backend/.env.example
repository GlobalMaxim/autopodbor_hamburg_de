# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,autopodbor-hamburg.de
# путь до админки — без слэшей, слэш добавляется сам в settings.py.
# не /admin, чтобы не ловить автоматический перебор ботами — но пока что
# оставлено дефолтным по просьбе заказчика.
# должен совпадать с ADMIN_URL_PREFIX в корневом .env (для Caddy)
ADMIN_URL=admin

# Postgres — "postgres" это имя сервиса в docker-compose.yml, не localhost.
# Для запуска без Docker (manage.py runserver напрямую) — поменять на localhost.
DATABASE_URL=postgres://autopodbor:autopodbor@postgres:5432/autopodbor

# S3 (медиа: фото/видео кейсов, отзывов, видео-примеров)
# пусто = используется локальный диск (удобно для разработки без AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
