# --- docker-compose (деплой на AWS-сервере) ---
SITE_DOMAIN=autopodbor-hamburg.de
# должен совпадать с ADMIN_URL в backend/.env
ADMIN_URL_PREFIX=admin
POSTGRES_PASSWORD=

# --- Next.js ---
# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# Bunny Stream — видео видеоотчётов (Library ID и CDN-хост из панели Bunny Stream).
# Без них видео в видеоотчётах считаются заглушками и не проигрываются.
NEXT_PUBLIC_BUNNY_LIBRARY_ID=
NEXT_PUBLIC_BUNNY_CDN_HOST=
